# AIRI configuration. None of these are required for the default flavor —
# /analyze, /project, /report* all work with zero env vars set.
#
# The vars below are only for the opt-in "Exact" flavor (see
# docs/EXACT_MODE.md). Until they're set, /auth/* and /analyze/exact
# return a clear 503 instead of a raw error; nothing else is affected.

# Neon (or any Postgres) connection string. Prefer Neon's pooled
# connection string — a free-tier host opening many short-lived
# connections is exactly what pooling is for.
DATABASE_URL=

# Long random string — signs session JWTs and peppers stored OTP-code
# hashes. Generate with: openssl rand -hex 32
AUTH_SECRET=

# From the Resend dashboard. RESEND_FROM_EMAIL must be on a domain
# you've verified in Resend (their sandbox domain can only email your
# own Resend account, not real users) — see docs/EXACT_MODE.md.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AIRI <otp@mail.yourdomain.com>

# Server-held, shared keys for the free provider token-counting APIs —
# not per-user BYOK keys. Exact mode for a provider is unavailable
# (503) until its key is set; the other provider (and the rest of AIRI)
# is unaffected.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
